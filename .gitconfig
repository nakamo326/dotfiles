[user]
	email = nakamo326@gmail.com
	name = Yasufumi Nakamoto
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[core]
	autocrlf = input
	safecrlf = true
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[diff]
	algorithm = histogram
[rerere]
	enabled = true
[include]
	# OS ごとの設定（git/macos.gitconfig または git/linux.gitconfig）
	path = ~/.config/git/os.gitconfig
[alias]
	dft = -c diff.external=difft diff
	dshow = -c diff.external=difft show
	dlog = -c diff.external=difft log -p --ext-diff
	bdiff = "!f() { base=${1:-main}; git -c diff.external=difft diff \"$base\"...HEAD; }; f"
	bstat = "!f() { base=${1:-main}; git diff --stat \"$base\"...HEAD; }; f"
